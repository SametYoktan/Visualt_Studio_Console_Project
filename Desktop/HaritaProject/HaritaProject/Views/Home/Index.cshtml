@model IEnumerable<HaritaProject.Models.Student>
@{
    ViewData["Title"] = "Home Page";
}

<head>
    <meta http-equiv="refresh" content="60">
</head>

<style>
    .table th, .table td {
        width: 25%; /* 3 sütun olduğu için eşit pay */
    }
</style>

<table class="table table-striped table-bordered text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>BAŞVURU NO</th>
            <th>DURUMU</th>
            <th>SONRAKİ DURUMU</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="align-middle">
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Surname</td>
                <td>@item.Age</td>
            </tr>
        }
    </tbody>
</table>